<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>work.nabit.sprint-cycle</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kemuniagent/todero/config/scripts/sprint-cycle.sh</string>
    </array>
    <!-- LaunchAgents uses LOCAL time. 6:55 local = 6:55am ET (5min before PR window at 7am) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>55</integer>
    </dict>
    <key>StandardOutPath</key><string>/tmp/sprint-cycle.log</string>
    <key>StandardErrorPath</key><string>/tmp/sprint-cycle.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/kemuniagent</string>
    </dict>
</dict>
</plist>
