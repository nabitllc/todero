<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sprint cycle — runs at 6:55am local time (5 min before PR window).
  Closes the outgoing sprint and opens the new one.
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>work.nabit.sprint-cycle</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__TODERO_DIR__/config/scripts/sprint-cycle.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>55</integer>
    </dict>
    <key>StandardOutPath</key><string>/tmp/sprint-cycle.log</string>
    <key>StandardErrorPath</key><string>/tmp/sprint-cycle.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOMEBREW_PREFIX__/opt/node@22/bin:__HOMEBREW_PREFIX__/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
