<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>work.nabit.drift-audit-nightly</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>echo "=== drift-audit-nightly $(date) ===" &amp;&amp; /Users/kemuniagent/todero/config/scripts/merged-branches-audit.py --flag &amp;&amp; echo "" &amp;&amp; /Users/kemuniagent/todero/config/scripts/direct-to-main-audit.py --since 30 --flag</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/drift-audit-nightly.log</string>
  <key>StandardErrorPath</key><string>/tmp/drift-audit-nightly.log</string>
</dict></plist>
