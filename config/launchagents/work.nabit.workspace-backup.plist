<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Workspace backup — runs hourly.
  Commits and pushes any changes to agent workspace dirs (SOUL.md, AGENTS.md,
  HEARTBEAT.md, self-improving/) to origin/main as a backup against hardware loss.
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>work.nabit.workspace-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kemuniagent/todero/config/scripts/workspace-backup.sh</string>
    </array>
    <key>StartInterval</key><integer>3600</integer>
    <key>StandardOutPath</key><string>/tmp/workspace-backup.log</string>
    <key>StandardErrorPath</key><string>/tmp/workspace-backup.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/git/bin</string>
        <key>HOME</key>
        <string>/Users/kemuniagent</string>
    </dict>
</dict>
</plist>
