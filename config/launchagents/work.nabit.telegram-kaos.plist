<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Telegram bot (KAOS v2) — persistent session bot.
  Requires: ANTHROPIC_API_KEY, TELEGRAM_BOT_TOKEN in environment (set in .env.local).
  Install: see bootstrap.sh
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>work.nabit.telegram-kaos</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOMEBREW_PREFIX__/bin/python3</string>
        <string>__TODERO_DIR__/config/scripts/telegram-kaos-v2.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__TODERO_DIR__/config/logs/telegram-kaos.out.log</string>
    <key>StandardErrorPath</key>
    <string>__TODERO_DIR__/config/logs/telegram-kaos.err.log</string>
    <key>WorkingDirectory</key>
    <string>__TODERO_DIR__/config</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__CLAUDE_BIN_DIR__:__HOMEBREW_PREFIX__/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
