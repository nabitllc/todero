      "parameters": {}
    },
    {
      "id": "deploy_ok",
      "name": "Deploy OK Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1450,
        50
      ],
      "parameters": {
        "jsCode": "const chat_id = $('Parse Command').first().json.chat_id;\nreturn [{ json: { chat_id, text: '\ud83d\ude80 *Vespera deploy triggered!*\\n\\nVercel build started. Check dashboard for progress.' } }];\n"
      }
    },
    {
      "id": "run_handler",
      "name": "Run Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        300
      ],
      "parameters": {
        "jsCode": "const arg = $('Parse Command').first().json.arg;\nconst chat_id = $('Parse Command').first().json.chat_id;\nif (arg === 'scout') {\n  return [{ json: { chat_id, text: '\ud83d\udd0d *Scout queued*\\n\\nScout agent will be spawned on the next heartbeat cycle.' } }];\n}\nreturn [{ json: { chat_id, text: `\u274c Unknown agent: *${arg || '(none)'}*\\n\\nUsage: /run scout` } }];\n"
      }
    },
    {
      "id": "help_msg",
      "name": "Help Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        450
      ],
      "parameters": {
        "jsCode": "const chat_id = $('Parse Command').first().json.chat_id;\nconst text = `\ud83e\udd9e *KemuniClaw Command Interface*\\n\\n/status \u2014 System status (agents, gateway, heartbeat)\\n/tasks \u2014 Top 5 open/in-progress tasks\\n/deploy vespera \u2014 Request a deploy (requires your APPROVE)\\n/run scout \u2014 Queue Scout agent for next heartbeat\\n/help \u2014 Show this message`;\nreturn [{ json: { chat_id, text } }];\n"
      }
    },
    {
      "id": "fallback_msg",
      "name": "Unknown Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        600
      ],
      "parameters": {
        "jsCode": "const chat_id = $('Parse Command').first().json.chat_id;\nconst raw = $('Parse Command').first().json.command;\nreturn [{ json: { chat_id, text: `\u2753 Unknown command: ${raw}\\n\\nType /help for available commands.` } }];\n"
      }
    },
    {
      "id": "send_reply",
      "name": "Send Telegram Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1650,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8556679902:AAGFg5yBUkF_6EtWHgf3TwTlxva0vbhQvVE/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"chat_id\": {{ $json.chat_id }}, \"text\": {{ JSON.stringify($json.text) }}, \"parse_mode\": \"Markdown\" }",
        "options": {
          "timeout": 10000
        }
      }
    }
