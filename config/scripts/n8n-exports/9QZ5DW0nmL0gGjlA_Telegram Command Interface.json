    {
      "id": "format_tasks",
      "name": "Format Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        -100
      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst tasks = Array.isArray(items[0]) ? items[0] : items;\nconst chat_id = $('Parse Command').first().json.chat_id;\n\nif (!tasks.length || (tasks.length === 1 && tasks[0].id === undefined)) {\n  return [{ json: { chat_id, text: '\ud83d\udccb *Tasks*\\n\\nNo open tasks found.' } }];\n}\n\nconst lines = ['\ud83d\udccb *Open Tasks*\\n'];\nconst icons = { open: '\u2b1c', in_progress: '\ud83d\udd04' };\nfor (const t of tasks) {\n  const icon = icons[t.status] || '\u2b1c';\n  const assignee = t.assigned_to ? ` \u2192 ${t.assigned_to}` : '';\n  lines.push(`${icon} *${t.title}*${assignee}`);\n  if (t.priority) lines.push(`   Priority: ${t.priority}`);\n}\n\nreturn [{ json: { chat_id, text: lines.join('\\n') } }];\n"
      }
    },
    {
      "id": "do_deploy",
      "name": "Deploy Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        100
      ],
      "parameters": {
        "jsCode": "\nconst arg = $('Parse Command').first().json.arg;\nconst chat_id = $('Parse Command').first().json.chat_id;\n// Deploy now routes through Deployer agent \u2014 no autonomous deploys\nreturn [{ json: { \n  chat_id, \n  text: `\ud83d\ude80 *Deploy Request Logged*\\n\\nDeploy target: *${arg || 'vespera'}*\\n\\nI've notified Deployer. You'll receive a formal deploy request with change summary shortly.\\n\\n_Deploys require your explicit APPROVE reply._`,\n  skip_deploy: true  \n} }];\n"
      }
    },
    {
      "id": "check_deploy",
      "name": "Valid Deploy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1050,
        100
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.skip_deploy }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "trigger_deploy",
      "name": "Deploy Disabled (use Deployer)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 4.2,
      "position": [
        1250,
        50
