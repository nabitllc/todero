    {
      "id": "fetch_status",
      "name": "Fetch Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        -300
      ],
      "parameters": {
        "url": "http://localhost:3000/api/status",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "format_status",
      "name": "Format Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        -300
      ],
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst lines = ['\ud83e\udd9e *OpenClaw Status*\\n'];\n\n// Gateway\nif (s.gateway) {\n  lines.push(`*Gateway:* ${s.gateway.status === 'online' ? '\ud83d\udfe2 Online' : '\ud83d\udd34 Offline'}`);\n}\n\n// Agents\nif (s.agents && s.agents.length) {\n  const active = s.agents.filter(a => a.status === 'active' || a.status === 'idle');\n  lines.push(`*Agents:* ${active.length}/${s.agents.length} active`);\n  for (const a of s.agents) {\n    const icon = (a.status === 'active' || a.status === 'idle') ? '\ud83d\udfe2' : '\u26aa';\n    lines.push(`  ${icon} ${a.name || a.id}`);\n  }\n}\n\n// Heartbeat\nif (s.openclaw && s.openclaw.heartbeat) {\n  lines.push(`\\n*Last heartbeat:* ${s.openclaw.heartbeat}`);\n}\n\n// Costs\nif (s.tokenUsage && s.tokenUsage.todayCost) {\n  lines.push(`*Today cost:* $${s.tokenUsage.todayCost}`);\n}\n\nconst chat_id = $('Parse Command').first().json.chat_id;\nreturn [{ json: { chat_id, text: lines.join('\\n') } }];\n"
      }
    },
    {
