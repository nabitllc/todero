    {
      "id": "parse",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst message = body.message || body.edited_message;\nif (!message || !message.text) {\n  return [{ json: { command: 'none', chat_id: 0 } }];\n}\nconst text = message.text.trim();\nconst chat_id = message.chat.id;\nconst parts = text.split(/\\s+/);\nconst cmd = parts[0].toLowerCase().replace(/@\\w+/, '');\nconst arg = parts.slice(1).join(' ').toLowerCase();\nreturn [{ json: { command: cmd, arg, chat_id, raw: text } }];\n"
      }
    },
    {
      "id": "router",
      "name": "Route Command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "status",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "/status",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "tasks",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.command }}",
