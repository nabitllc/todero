    {
      "id": "build-digest",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ghItem = items.find(i => i.json.total_count !== undefined);\nconst hnItem = items.find(i => i.json.hits !== undefined);\nconst today = new Date().toLocaleDateString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', year: 'numeric' });\nlet msg = `\ud83d\udd0d **Market Research Digest \u2014 ${today}**\\n`;\nmsg += `\\n**\ud83d\udc19 Trending AI Agent Repos**\\n`;\nconst repos = ghItem?.json?.items?.slice(0, 5) ?? [];\nfor (const r of repos) {\n  const desc = (r.description || 'No description').slice(0, 70);\n  msg += `\u2022 **${r.full_name}** \u2b50${r.stargazers_count.toLocaleString()} \u2014 ${desc}\\n`;\n}\nif (!repos.length) msg += '\u2022 No results\\n';\nmsg += `\\n**\ud83d\udfe0 HackerNews \u2014 AI Agents**\\n`;\nconst hits = hnItem?.json?.hits?.slice(0, 5) ?? [];\nfor (const h of hits) {\n  const title = (h.title || '').slice(0, 70);\n  const pts = h.points || 0;\n  const url = h.url ? ` <${h.url}>` : '';\n  msg += `\u2022 **${title}** (${pts} pts)${url}\\n`;\n}\nif (!hits.length) msg += '\u2022 No recent stories\\n';\nmsg += `\\n_KAOS Market Research \u00b7 ${today}_`;\nreturn [{ json: { content: msg } }];"
      }
    },
