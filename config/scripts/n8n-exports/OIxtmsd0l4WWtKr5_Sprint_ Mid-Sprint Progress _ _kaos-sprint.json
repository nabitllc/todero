    {
      "name": "Format Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "\nconst today = new Date().toISOString().slice(0,10);\nconst all = $input.all().map(i=>i.json);\nconst done = all.filter(t => t.status === 'done' && t.updated_at?.slice(0,10) === today);\nconst carried = all.filter(t => t.sprint === today && !['done','closed','canceled'].includes(t.status));\nlet lines = [`\ud83c\udfc1 **Sprint End \u2014 ${today}**\\n`];\nlines.push(`\u2705 **Shipped today (${done.length}):**`);\nfor (const t of done.slice(0,8)) lines.push(`  \u2022 ${t.title.slice(0,55)}`);\nif (done.length > 8) lines.push(`  _...and ${done.length-8} more_`);\nif (carried.length) {\n  lines.push(`\\n\u23ed **Carried over (${carried.length}):**`);\n  for (const t of carried.slice(0,4)) lines.push(`  \u2022 ${t.title.slice(0,55)}`);\n}\nlines.push(`\\n_Velocity: ${done.length} tasks shipped._`);\nreturn [{json:{content: lines.join('\\n')}}];\n"
      },
      "id": "fcfa0423-614f-47e4-80ff-65ff7e862f0d"
    },
