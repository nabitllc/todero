{
  "id": "9D8iRQnfghBgqwiM",
  "name": "MC Health Check + Auto-Restart",
  "active": false,
  "nodes": [
    {
      "name": "Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "2181db0e-bc02-4517-8764-fd06a26fa406"
    },
    {
      "name": "Check MC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "url": "http://localhost:3000/api/status",
        "timeout": 5000,
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "56085b5b-918d-4f9c-8c28-0378639d8a54"
    },
    {
      "name": "Evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst body = items[0]?.json ?? {};\nconst isUp = body?.gateway?.running === true;\nif (isUp) return [];\nreturn [{json:{down:true}}];\n"
      },
      "id": "1a16e9d2-4bd3-4558-ad83-58efbbe7a6ae"
    },
    {
      "name": "Restart MC",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "command": "/bin/bash /Users/kemuniagent/mission-control/start.sh > /tmp/mc-restart.log 2>&1 &\nsleep 1\necho done"
      },
      "id": "4497e9fd-5b14-4e12-9137-61fd17a85ac3"
    },
    {
      "name": "Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "chatId": "-1003598670302",
        "text": "\u26a0\ufe0f *Mission Control was down \u2014 auto-restarted.*\n\nCheck kaos.nabit.work in ~15s.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "hr4GqvusMW8IUI9D",
          "name": "KemuniClaw1Bot"
        }
      },
      "id": "0261c65b-8fb6-43e0-acc5-e25262bf458a"
    }
  ],
  "connections": {
