      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ghItem = items.find(i => i.json.total_count !== undefined);\nconst hnItem = items.find(i => i.json.hits !== undefined);\nconst today = new Date().toLocaleDateString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', year: 'numeric' });\n\nlet msg = `\ud83d\udd27 **Infrastructure & DevOps Research \u2014 ${today}**\\n`;\n\nmsg += `\\n**\ud83d\udc19 Trending DevOps / AI Infra Repos**\\n`;\nconst repos = ghItem?.json?.items?.slice(0, 5) ?? [];\nfor (const r of repos) {\n  const desc = (r.description || 'No description').slice(0, 70);\n  msg += `\u2022 **${r.full_name}** \u2b50${(r.stargazers_count||0).toLocaleString()} \u2014 ${desc}\\n`;\n}\nif (!repos.length) msg += '\u2022 No results\\n';\n\nmsg += `\\n**\ud83d\udfe0 HackerNews \u2014 Tools & Security**\\n`;\nconst hits = hnItem?.json?.hits?.slice(0, 5) ?? [];\nfor (const h of hits) {\n  const title = (h.title || '').slice(0, 70);\n  const url = h.url || `https://news.ycombinator.com/item?id=${h.objectID}`;\n  msg += `\u2022 [${title}](${url})\\n`;\n}\nif (!hits.length) msg += '\u2022 No results\\n';\n\nmsg += `\\n**\ud83d\udca1 Consider for our stack**\\n`;\nmsg += `\u2022 Security: rotate secrets, audit token scopes, check CVEs in dependencies\\n`;\nmsg += `\u2022 Automation: new n8n nodes, OpenClaw updates, agent framework patterns\\n`;\nmsg += `\u2022 Observability: structured logging, cost tracking, session replay\\n`;\nmsg += `\u2022 Best practices: review OWASP top 10 for our API surface\\n`;\n\nreturn [{ json: { text: msg } }];"
      }
