    {
      "name": "Any Approved?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "\nconst tasks = $('Get Approved Tasks').all().map(i=>i.json);\nif(!tasks.length) return [];\n\nconst list = tasks.map(t=>`  \u2022 ${t.title.slice(0,55)} ${t.pr_url ? '[PR]('+t.pr_url+')' : ''}`).join('\\n');\nconst projects = [...new Set(tasks.map(t=>t.project))].join(', ');\n\nconst msg = `\ud83d\ude80 *Ready to Deploy*\\n\\n*${projects}* \u2014 ${tasks.length} task(s) approved:\\n\\n${list}\\n\\n_Reply *APPROVE* to deploy or *HOLD* to delay._\\n\\nDeployer will prepare change summary before firing webhook.`;\nreturn [{json:{text: msg, task_ids: tasks.map(t=>t.id)}}];\n"
      },
      "id": "764b51c0-93a5-4b36-b7c2-44706b4e9705"
    },
