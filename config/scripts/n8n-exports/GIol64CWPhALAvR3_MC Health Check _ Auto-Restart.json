{
  "id": "GIol64CWPhALAvR3",
  "name": "MC Health Check + Auto-Restart",
  "active": false,
  "nodes": [
    {
      "name": "Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "257a36b3-5ce0-4a9e-a108-01a04420e192"
    },
    {
      "name": "Check MC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "url": "http://localhost:3000/api/status",
        "timeout": 5000,
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "c9f436dc-deca-4fcf-b308-b34ecb07389c"
    },
    {
      "name": "Is Down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "a",
              "leftValue": "={{ $json.gateway.running }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "9c3a6fa0-603f-4dd2-847d-a234339059ac"
    },
    {
      "name": "Auto-Restart MC",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        400
      ],
      "parameters": {
        "command": "nohup /bin/bash /Users/kemuniagent/mission-control/start.sh > /tmp/mc-restart.log 2>&1 &"
      },
      "id": "374b55fa-b3c0-4198-bca3-deb83ea3d417"
    },
    {
      "name": "Alert Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "chatId": "-1003598670302",
        "text": "\u26a0\ufe0f *Mission Control was down \u2014 auto-restarting now.*\n\nCheck kaos.nabit.work in ~15s.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "hr4GqvusMW8IUI9D",
          "name": "KemuniClaw1Bot"
        }
      },
      "id": "83f49df7-b039-40d7-8620-2f264aaeac96"
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Check MC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check MC": {
      "main": [
        [
          {
            "node": "Is Down?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Down?": {
      "main": [
        [],
        [
          {
            "node": "Auto-Restart MC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auto-Restart MC": {
      "main": [
        [
          {
            "node": "Alert Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  }
}