        680,
        300
      ],
      "parameters": {
        "jsCode": "\nconst d = $input.first().json;\nconst results = d.web?.results || [];\nif (!results.length) return [{json:{content:'\ud83d\udcca No market news found today.'}}];\nconst date = new Date().toLocaleDateString('en-US',{month:'short',day:'numeric'});\nlet lines = [`\ud83d\udcca **Kemuni Market Research \u2014 ${date}**\\n`];\nfor (let i=0; i<Math.min(5,results.length); i++) {\n  const r = results[i];\n  lines.push(`**${i+1}. ${r.title}**`);\n  lines.push(`${(r.description||'').slice(0,120)}...`);\n  lines.push(`<${r.url}>`);\n  lines.push('');\n}\nreturn [{json:{content: lines.join('\\n').slice(0,1999)}}];\n"
      },
      "id": "4b6f2334-2f68-418d-813a-0d45529bad68"
