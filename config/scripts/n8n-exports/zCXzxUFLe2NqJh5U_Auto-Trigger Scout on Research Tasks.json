{
  "id": "zCXzxUFLe2NqJh5U",
  "name": "Auto-Trigger Scout on Research Tasks",
  "active": false,
  "nodes": [
    {
      "name": "Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "88b7e496-e39e-484d-bddb-264d21f9c38f"
    },
    {
      "name": "Get Scout Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "url": "${NEXT_PUBLIC_SUPABASE_URL}/rest/v1/issues",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "assignee",
              "value": "eq.scout"
            },
            {
              "name": "status",
              "value": "eq.open"
            },
            {
              "name": "select",
              "value": "id,title,updated_at"
            },
            {
              "name": "limit",
              "value": "10"
            }
          ]
        }
      },
      "id": "1e71848c-a2e9-4178-96cd-b5a3694a9c6a"
    },
    {
      "name": "Filter Fresh",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "\nconst tasks = $('Get Scout Tasks').all().map(i=>i.json);\nconst cutoff = new Date(Date.now()-15*60*1000);\nconst fresh = tasks.filter(t=>t.updated_at && new Date(t.updated_at) > cutoff);\nif(!fresh.length) return [];\nreturn [{json:{count:fresh.length, tasks:fresh, text:`\ud83d\udd0d *Scout triggered*\\n\\n${fresh.length} research task(s) assigned:\\n\\n`+fresh.map(t=>`  \u2022 ${t.title.slice(0,55)}`).join('\\n')+'\\n\\n_Scout is running..._'}}];\n"
      },
      "id": "b13a438d-16a1-40db-adc7-87eeebd1bc4b"
    },
    {
      "name": "Notify",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "chatId": "-1003598670302",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "hr4GqvusMW8IUI9D",
          "name": "KemuniClaw1Bot"
        }
      },
      "id": "161ef566-a2c1-43ac-bc0e-eb9d631f4e17"
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Get Scout Tasks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Scout Tasks": {
      "main": [
        [
          {
            "node": "Filter Fresh",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Fresh": {
      "main": [
        [
          {
            "node": "Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  }
}