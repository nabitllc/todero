{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "lexical": ["./node_modules/lexical/index.d.ts"]
    }
  },
  "include": ["src", "storybook"],
  // *.gauntlet.ts(x) fail on purpose until their work item is done (docs/ai_context/gauntlet); vitest runs them, tsc does not.
  "exclude": ["src/**/*.gauntlet.ts", "src/**/*.gauntlet.tsx"]
}
