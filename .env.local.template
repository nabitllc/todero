# .env.local — Todero environment variables
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to git.
#
# To get these values:
#   - Supabase: https://app.supabase.com → your project → Settings → API
#   - Telegram: https://t.me/BotFather → your bot token
#   - Anthropic: https://console.anthropic.com → API Keys
#   - Discord: https://discord.com/developers/applications → your app → Bot

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY

# ── Telegram ──────────────────────────────────────────────────────────────────
# KaosClaudeBot token (primary bot — KAOS v2 uses this)
TELEGRAM_BOT_TOKEN=YOUR_KAOSCLAUDE_BOT_TOKEN
# KaosGPTBot token (legacy — only needed if still running v1 bot)
# TELEGRAM_GPT_BOT_TOKEN=YOUR_KAOSGPT_BOT_TOKEN

# ── Telegram chat routing ─────────────────────────────────────────────────────
# Chat IDs the KAOS bot posts to (DM with you, and the group chat)
TELEGRAM_DM_CHAT=YOUR_DM_CHAT_ID
TELEGRAM_GROUP_CHAT=YOUR_GROUP_CHAT_ID

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_GUILD_ID
DISCORD_ALERTS_CHANNEL_ID=YOUR_ALERTS_CHANNEL_ID
DISCORD_OWNER_ID=YOUR_DISCORD_USER_ID

# ── App URL ───────────────────────────────────────────────────────────────────
# Set to your Vercel URL when deployed, or http://localhost:3000 for local dev.
# Used by agents to call the API (run-agent route, watchdog, etc.)
NEXT_PUBLIC_APP_URL=https://YOUR_PROJECT.vercel.app

# ── GitHub ────────────────────────────────────────────────────────────────────
# Used by pr-window.py to merge PRs
GITHUB_TOKEN=YOUR_GITHUB_PAT
GITHUB_REPO=nabitllc/todero

# ── MC dashboard auth ─────────────────────────────────────────────────────────
MC_PASSWORD=YOUR_MC_ADMIN_PASSWORD
MC_VIEWER_PASSWORD=YOUR_MC_VIEWER_PASSWORD

# ── OpenRouter (non-Claude agent models) ──────────────────────────────────────
OPENROUTER_API_KEY=sk-or-YOUR_KEY

# ── Agent runtime ─────────────────────────────────────────────────────────────
# Where run-agent reads agent context from (e.g. "db" or "files")
AGENT_CONTEXT_SOURCE=db

# ── CLI binary paths (agent spawner) ──────────────────────────────────────────
# Adjust if installed elsewhere (check with: which claude codex cursor-agent)
CLAUDE_BIN=/Users/kemuniagent/.local/bin/claude
CODEX_BIN=/opt/homebrew/bin/codex
CURSOR_BIN=/opt/homebrew/bin/cursor-agent
