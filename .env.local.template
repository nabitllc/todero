# .env.local — Todero environment variables
#
# `npm run setup` copies this file to .env.local. You then fill in real values;
# `npm run doctor` tells you which ones are still missing, by name.
# NEVER commit .env.local to git.
#
# To get these values:
#   - Ollama (local LLM): https://ollama.com → `ollama pull qwen2.5-coder:7b`
#   - Supabase: https://app.supabase.com → your project → Settings → API
#   - Telegram: https://t.me/BotFather → your bot token
#   - Anthropic: https://console.anthropic.com → API Keys
#   - Discord: https://discord.com/developers/applications → your app → Bot

# ── LLM endpoint ──────────────────────────────────────────────────────────────
# The one seam the chat tab AND every agent runtime talk to. OpenAI-compatible
# /chat/completions + /models — nothing here names a vendor, so moving
# between a local model and a hosted one is these three lines, not a code change.
#
#   Ollama (local, free, the default):  http://localhost:11434/v1
#   LM Studio (local):                  http://localhost:1234/v1
#   OpenRouter / Together / Azure / vLLM: whatever base URL they document
#
# There is deliberately NO fallback: leave LLM_BASE_URL unset and Todero reports
# that it is unconfigured rather than quietly dialling somebody's cloud account.
LLM_BASE_URL=http://localhost:11434/v1

# Default model id, spelled exactly as the endpoint above names it. Blank means
# "use the first model that endpoint reports" — never a hardcoded vendor model.
LLM_MODEL=qwen2.5-coder:7b

# Bearer token for the endpoint above. Leave blank for a local server; it is
# ignored there. Required for any hosted endpoint.
LLM_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Which adapter under lib/db/ backs every query. Three ship today:
#
#   sqlite              — ONE FILE under the checkout, through the
#                         `better-sqlite3` driver. Needs nothing at all: no
#                         server, no account, no connection string. This is
#                         what you get if you set none of the variables below,
#                         and it is a real database, not a demo mode.
#                         (`better-sqlite3` is a compiled module; if it will
#                         not load, `npm run doctor` says so and names the fix.)
#   supabase            — hosted Postgres behind an HTTP query layer.
#                         Needs NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
#   postgres            — ANY Postgres reachable by connection string, over the
#                         plain node-postgres driver. Needs DATABASE_URL.
#                         Use this for Neon / Vercel Postgres / RDS / a local
#                         container. Switching hosts is a connection string,
#                         not a code change.
#
# Left unset, Todero picks: supabase if its credentials are here, else postgres
# if DATABASE_URL is here, else sqlite. Set it to pin one explicitly.
# Add another key in lib/db/adapters.ts to support a different engine.
# TODERO_DB_PROVIDER=sqlite

# Where the `sqlite` adapter keeps its file. Defaults to db.sqlite in the repo
# root. Delete that file to start from an empty board; re-create it with
# `npm run db:migrate`.
# TODERO_SQLITE_PATH=./db.sqlite

# Credentials for the `supabase` adapter. Both are REQUIRED when it is active —
# the app refuses to guess, and every route names the missing variable rather
# than failing blank.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Credentials for the `postgres` adapter. Required when TODERO_DB_PROVIDER=postgres.
#   Neon / Vercel Postgres: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#   Local container:        postgresql://postgres:postgres@localhost:5432/todero
# TODERO_DB_PROVIDER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Workspace owner ───────────────────────────────────────────────────────────
# Email recorded as the owner of workspaces created by the onboarding wizard.
# TODERO_OWNER_EMAIL=you@example.com
#
# Workflow identity the owner's own actions are attributed to (`transitioned_by`
# on every issue transition made from the UI). Defaults to `michael`, the name
# the workflow engine's admin bypass was written against. Public — it is a
# username, not a secret, and the browser reads it to label Board drags.
# NEXT_PUBLIC_TODERO_OWNER_IDENTITY=michael

# ── Claude / Anthropic ────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-YOUR_KEY

# ── Telegram ──────────────────────────────────────────────────────────────────
# KaosClaudeBot token (primary bot — KAOS v2 uses this)
# TELEGRAM_BOT_TOKEN=YOUR_KAOSCLAUDE_BOT_TOKEN
# KaosGPTBot token (legacy — only needed if still running v1 bot)
# TELEGRAM_GPT_BOT_TOKEN=YOUR_KAOSGPT_BOT_TOKEN

# ── Telegram chat routing ─────────────────────────────────────────────────────
# Chat IDs the KAOS bot posts to (DM with you, and the group chat)
# TELEGRAM_DM_CHAT=YOUR_DM_CHAT_ID
# TELEGRAM_GROUP_CHAT=YOUR_GROUP_CHAT_ID

# ── Discord ───────────────────────────────────────────────────────────────────
# DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# DISCORD_GUILD_ID=YOUR_GUILD_ID
# DISCORD_ALERTS_CHANNEL_ID=YOUR_ALERTS_CHANNEL_ID
# DISCORD_OWNER_ID=YOUR_DISCORD_USER_ID

# ── App URL ───────────────────────────────────────────────────────────────────
# Set to your Vercel URL when deployed, or http://localhost:3000 for local dev.
# Used by agents to call the API (run-agent route, watchdog, etc.)
# NEXT_PUBLIC_APP_URL=https://YOUR_PROJECT.vercel.app

# ── GitHub ────────────────────────────────────────────────────────────────────
# Used by pr-window.py to merge PRs
# GITHUB_TOKEN=YOUR_GITHUB_PAT
# GITHUB_REPO=nabitllc/todero

# ── MC dashboard auth ─────────────────────────────────────────────────────────
# MC_PASSWORD=YOUR_MC_ADMIN_PASSWORD
# MC_VIEWER_PASSWORD=YOUR_MC_VIEWER_PASSWORD

# ── Agent runtime ─────────────────────────────────────────────────────────────
# Where run-agent reads agent context from (e.g. "db" or "files")
AGENT_CONTEXT_SOURCE=db

# ── Filesystem layout (all optional — sensible defaults on every OS) ──────────
# Root of the Todero checkout. Default: the cwd if it has a package.json,
# otherwise ~/todero. Set it when running Todero from outside the repo.
# TODERO_DIR=/path/to/todero
# Files the agent file browser and agents can read/write.
# Default: <TODERO_DIR>/config
# TODERO_WORKSPACE_DIR=/path/to/todero/config
# Agent config/memory/scripts repo. Default: <TODERO_DIR>/config
# TODERO_CONFIG_DIR=/path/to/todero/config
# Where Todero writes agent logs. Default: <os tmpdir>/todero-logs
# TODERO_LOG_DIR=/path/to/logs
# Explicit path to the AGENTS.md roster. Default: the first AGENTS.md found in
# TODERO_DIR, TODERO_CONFIG_DIR, then TODERO_WORKSPACE_DIR.
# TODERO_AGENTS_MD=/path/to/AGENTS.md
# Where per-spawn git worktrees are created.
# Default: <os tmpdir>/todero-worktrees
# AGENT_WORKTREE_ROOT=/path/to/worktrees

# ── CLI binary paths (agent spawner) ──────────────────────────────────────────
# Bare names are looked up on PATH (`where` on Windows, `which` elsewhere), so
# leave these unset if the CLIs are installed normally. Set an absolute path
# only to override. Defaults: claude / codex / cursor-agent
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# CURSOR_BIN=cursor-agent
