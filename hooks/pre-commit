#!/bin/bash
# MC-207: Prevent broken TypeScript from being committed
# Runs npm run build and rejects the commit if it fails.

echo "[pre-commit] Running TypeScript build check..."
cd /Users/kemuniagent/mission-control
/opt/homebrew/opt/node@22/bin/node node_modules/.bin/next build 2>&1 | tail -20

if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo ""
  echo "❌ [pre-commit] Build failed — commit rejected."
  echo "   Fix TypeScript errors before committing."
  exit 1
fi

echo "✅ [pre-commit] Build passed."
exit 0
