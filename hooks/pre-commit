#!/bin/bash
echo "[pre-commit] Running TypeScript build check..."
cd /Users/kemuniagent/todero
rm -rf .next
PATH="/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:$PATH" npx next build 2>&1 | tail -20

if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo ""
  echo "❌ [pre-commit] Build failed — commit rejected."
  echo "   Fix TypeScript errors before committing."
  exit 1
fi

echo "✅ [pre-commit] Build passed."
exit 0
