#!/bin/bash
# Post-commit: REBUILD ONLY, do NOT restart server
# Reason: restarting invalidates browser chunks (ChunkLoadError in open tabs).
# The running server keeps serving its current build fine.
# A manual restart or LaunchAgent auto-recovery (via start.sh) will pick up the new build later.
#
# If you want to force a server restart after commit, run:
#   launchctl kickstart -k "gui/$(id -u)/work.nabit.todero"

echo "[post-commit] Rebuilding Next.js (in background, no restart)..."
cd /Users/kemuniagent/todero

# Clean .next to avoid stale pages-manifest.json errors
rm -rf .next

# Run build in background so commit returns fast
nohup /opt/homebrew/opt/node@22/bin/node node_modules/.bin/next build > /tmp/mc-build.log 2>&1 &
disown

echo "[post-commit] Build queued. Server NOT restarted (protects open browser sessions)."
echo "[post-commit] To pick up new build, run: launchctl kickstart -k gui/\$(id -u)/work.nabit.todero"
