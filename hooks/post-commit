#!/bin/bash
# Auto-rebuild Next.js and restart server after commits
# The LaunchAgent (com.nabit.todero) will auto-recover via start.sh if build is missing

echo "[post-commit] Rebuilding Next.js (clean)..."
cd /Users/kemuniagent/todero

# Clean .next to avoid stale pages-manifest.json errors
rm -rf .next

/opt/homebrew/opt/node@22/bin/node node_modules/.bin/next build 2>&1 | tail -10

if [ -f .next/BUILD_ID ]; then
  echo "[post-commit] Build succeeded. Restarting Todero server..."
  launchctl kickstart -k "gui/$(id -u)/com.nabit.todero" 2>/dev/null || true
  echo "[post-commit] Server restart triggered."
else
  echo "[post-commit] ⚠ Build failed — BUILD_ID missing. LaunchAgent will auto-rebuild on next start."
fi
