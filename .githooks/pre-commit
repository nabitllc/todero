#!/bin/bash
# pre-commit hook: prevent Builder/agent feature branches from modifying
# infrastructure files that control the pipeline itself.
#
# These files have been reverted 5+ times by agents working on stale
# feature branches. The revert wipes critical configs (wipExtraFilter,
# selfChainOnStatus, channel routing, worktree isolation) and breaks
# the pipeline for hours until someone notices.
#
# Only commits on `main` by `michael` or `main` (KAOS) are allowed to
# touch these files. Feature-branch commits are rejected with a
# descriptive error.

LOCKED_FILES=(
  "lib/agent-queue.ts"
  "lib/issue-routing.ts"
  "lib/issue-lifecycle.ts"
  "lib/runtimes/claude-code.ts"
  "lib/runtimes/worktree.ts"
  "lib/constants.ts"
  "app/api/issues/route.ts"
  "app/api/run-agent/route.ts"
  "app/api/notify/route.ts"
  "app/api/queue-refill/route.ts"
)

# Get current branch
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# Allow commits on main (KAOS, michael, or this Claude session)
if [ "$BRANCH" = "main" ]; then
  exit 0
fi

# ── WORKTREE ISOLATION GUARD ────────────────────────────────────────────────
# Code agents (builder/ops) must commit from an isolated worktree, not the
# main checkout. Committing from main means the agent's working tree is the
# same as every other session's, which caused edit races where one session
# silently reverted another's changes.
#
# Detection: a worktree's --git-dir differs from --git-common-dir. If they
# match, this IS the main checkout.
# Bypass (human manual fixup on a feat/ branch): git commit --no-verify
# ──────────────────────────────────────────────────────────────────────────
if echo "$BRANCH" | grep -qE '^feat/(tod|TOD)-[0-9]+$'; then
  GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
  COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null)
  # Normalize paths — --git-dir can be relative, --git-common-dir absolute
  GIT_DIR_ABS=$(cd "$GIT_DIR" 2>/dev/null && pwd)
  COMMON_DIR_ABS=$(cd "$COMMON_DIR" 2>/dev/null && pwd)
  if [ -n "$GIT_DIR_ABS" ] && [ "$GIT_DIR_ABS" = "$COMMON_DIR_ABS" ]; then
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "  🔒 BLOCKED: $BRANCH committed from the MAIN checkout,"
    echo "     not an isolated worktree."
    echo ""
    echo "  Code agents (builder/ops) must run in ~/agent-worktrees/<key>/"
    echo "  to prevent edit races between parallel sessions."
    echo ""
    echo "  Bypass (human manual fixup): git commit --no-verify"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    exit 1
  fi
fi

# Check if any staged files are in the locked list
STAGED=$(git diff --cached --name-only)
BLOCKED=""

for file in "${LOCKED_FILES[@]}"; do
  if echo "$STAGED" | grep -qx "$file"; then
    BLOCKED="${BLOCKED}
  ❌ $file"
  fi
done

if [ -n "$BLOCKED" ]; then
  echo ""
  echo "═══════════════════════════════════════════════════════════════"
  echo "  🔒 BLOCKED: Infrastructure files cannot be modified on"
  echo "     feature branches. These files control the pipeline and"
  echo "     have been accidentally reverted 5+ times."
  echo ""
  echo "  Blocked files:${BLOCKED}
"
  echo ""
  echo "  Branch: $BRANCH"
  echo ""
  echo "  If you need to change these files, commit directly on main."
  echo "  If you're a Builder agent: skip these files. Your task"
  echo "  should not require modifying pipeline infrastructure."
  echo "═══════════════════════════════════════════════════════════════"
  echo ""
  exit 1
fi

exit 0
