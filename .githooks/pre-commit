#!/bin/bash
# pre-commit hook: enforce branch/file separation for agent commits.
#
# BRANCH RULES (enforced below):
#   main                — allows everything (KAOS/michael's path)
#   feat/tod-NNNN       — app-code only. LOCKED_FILES blocked.
#   infra/tod-NNNN      — LOCKED_FILES only. App-code blocked. (P3 new.)
#   anything else       — no enforcement (human fixup branches)
#
# WHY TWO BRANCH PREFIXES
# Before P3, any infra-touching work had to happen on main, which required a
# human since agents are scoped to feature branches. That bottlenecked
# ops-typed issues. With infra/tod-NNNN, a type=ops issue's agent commits
# LOCKED_FILES in its own worktree and the pr-window rolls it into release
# just like feat/tod-NNNN. App-code changes stay blocked on infra/ so the two
# paths can't accidentally mix into one PR (the failure mode that produced
# TOD-604 mixed-commit drift).

LOCKED_FILES=(
  "lib/agent-queue.ts"
  "lib/issue-routing.ts"
  "lib/issue-lifecycle.ts"
  "lib/runtimes/claude-code.ts"
  "lib/runtimes/worktree.ts"
  "lib/constants.ts"
  "app/api/issues/route.ts"
  "app/api/run-agent/route.ts"
  "app/api/notify/route.ts"
  "app/api/queue-refill/route.ts"
  ".githooks/pre-commit"
)

# Get current branch
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# ── RECONSTRUCTION BRANCHES ────────────────────────────────────────────────
# rebuild/*  — mixed-concern work is ALLOWED.
#
# The feat//infra split below exists because Todero used to build itself: one
# issue produced one narrow agent branch, and mixing app code with pipeline
# infrastructure on the same branch was how LOCKED_FILES kept getting reverted.
#
# That premise does not hold for a whole-repo reconstruction, which necessarily
# touches the auth gate, the runtime layer and the UI in one change. Forcing it
# through two alternating branches would produce commits that never build.
#
# The protection the split provided is now covered by scripts/acceptance/ —
# run `node scripts/acceptance/run.mjs` before and after a change and a reverted
# LOCKED_FILE shows up as a failing check in seconds, which is a stronger guard
# than a filename blocklist ever was.
# ──────────────────────────────────────────────────────────────────────────
case "$BRANCH" in
  rebuild/*) exit 0 ;;
esac

# Allow commits on main (KAOS, michael, or this Claude session)
if [ "$BRANCH" = "main" ]; then
  exit 0
fi

# ── WORKTREE ISOLATION GUARD ────────────────────────────────────────────────
# Code agents (builder/ops) must commit from an isolated worktree, not the
# main checkout. Committing from main means the agent's working tree is the
# same as every other session's, which caused edit races where one session
# silently reverted another's changes.
#
# Detection: a worktree's --git-dir differs from --git-common-dir. If they
# match, this IS the main checkout.
# Bypass (human manual fixup on a feat/ or infra/ branch): git commit --no-verify
# ──────────────────────────────────────────────────────────────────────────
if echo "$BRANCH" | grep -qE '^(feat|infra)/(tod|TOD)-[0-9]+$'; then
  GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
  COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null)
  # Normalize paths — --git-dir can be relative, --git-common-dir absolute
  GIT_DIR_ABS=$(cd "$GIT_DIR" 2>/dev/null && pwd)
  COMMON_DIR_ABS=$(cd "$COMMON_DIR" 2>/dev/null && pwd)
  if [ -n "$GIT_DIR_ABS" ] && [ "$GIT_DIR_ABS" = "$COMMON_DIR_ABS" ]; then
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "  🔒 BLOCKED: $BRANCH committed from the MAIN checkout,"
    echo "     not an isolated worktree."
    echo ""
    echo "  Code agents (builder/ops) must run in ~/agent-worktrees/<key>/"
    echo "  to prevent edit races between parallel sessions."
    echo ""
    echo "  Bypass (human manual fixup): git commit --no-verify"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    exit 1
  fi
fi

# ── LOCKED_FILES RULES (branch-aware) ───────────────────────────────────────
# feat/tod-*  → LOCKED_FILES are BLOCKED.
# infra/tod-* → LOCKED_FILES are ALLOWED; app-code is BLOCKED.
# Anything else → no enforcement (human fixup branches).
# ──────────────────────────────────────────────────────────────────────────
STAGED=$(git diff --cached --name-only)

if echo "$BRANCH" | grep -qE '^infra/(tod|TOD)-[0-9]+$'; then
  # Infra branch: app-code blocked, LOCKED_FILES allowed.
  APP_BLOCKED=""
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    is_locked=0
    for locked in "${LOCKED_FILES[@]}"; do
      if [ "$file" = "$locked" ]; then
        is_locked=1
        break
      fi
    done
    if [ "$is_locked" -eq 0 ]; then
      APP_BLOCKED="${APP_BLOCKED}
  ❌ $file"
    fi
  done <<< "$STAGED"

  if [ -n "$APP_BLOCKED" ]; then
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "  🔒 BLOCKED: infra/ branches may only modify LOCKED_FILES"
    echo "     (pipeline infrastructure). App-code changes belong on a"
    echo "     feat/ branch."
    echo ""
    echo "  Blocked (non-LOCKED) files:${APP_BLOCKED}"
    echo ""
    echo "  Branch: $BRANCH"
    echo ""
    echo "  If this issue needs both app-code + infra changes, split it"
    echo "  into two sibling tasks: type=feature (feat/) + type=ops"
    echo "  (infra/). Mixed-concern branches were the bug this rule"
    echo "  exists to prevent (TOD-604-style drift)."
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    exit 1
  fi
  exit 0
fi

# Feat branch (or any non-infra non-main branch): LOCKED_FILES blocked.
BLOCKED=""
for file in "${LOCKED_FILES[@]}"; do
  if echo "$STAGED" | grep -qx "$file"; then
    BLOCKED="${BLOCKED}
  ❌ $file"
  fi
done

if [ -n "$BLOCKED" ]; then
  echo ""
  echo "═══════════════════════════════════════════════════════════════"
  echo "  🔒 BLOCKED: Infrastructure files cannot be modified on"
  echo "     feature branches. These files control the pipeline and"
  echo "     have been accidentally reverted 5+ times."
  echo ""
  echo "  Blocked files:${BLOCKED}"
  echo ""
  echo "  Branch: $BRANCH"
  echo ""
  echo "  If you're a Builder agent: skip these files. Your task"
  echo "  should not require modifying pipeline infrastructure."
  echo ""
  echo "  If you're an Ops agent and your issue IS pipeline infra,"
  echo "  your branch should have been created as infra/tod-NNNN"
  echo "  rather than feat/tod-NNNN. Patch the issue's feature_branch"
  echo "  field to infra/<key> and retry — your next spawn will land"
  echo "  on the correct branch."
  echo "═══════════════════════════════════════════════════════════════"
  echo ""
  exit 1
fi

exit 0
