node_modules/
# Any Next build output, whatever distDir a verification build chose.
# A glob, not a list: agents pick their own dir names to avoid clobbering the
# dev server, and .next-ac3 (123MB) got committed because the ignore named only
# the one dir this session happened to use.
.next*/
.env*.local
.vercel
*.log

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Next.js generated types
next-env.d.ts

# Claude / Codex / Cursor local session state
.claude/
.codex/
.cursor/

# Test + coverage
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Stray local service-health snapshots from redirected script output
st.json
scripts/acceptance/.gate.lock

# Local SQLite database — the zero-account default provider (lib/db/sqlite-adapter.ts)
# and its write-ahead-log sidecars. This is machine-local data, never shared state.
/db.sqlite
/db.sqlite-wal
/db.sqlite-shm
.next-critic/

# Stray crash-log fragments from harness runs
output.txt

# Database exports — history, not source. Keep out of git.
exports/

# TOD-2457: the archived companion checkout. Untracked at the owner's
# direction after a live OpenRouter key was found committed to origin/main in
# four files here. Ignoring it is also what removes the carve-outs from
# scripts/check-no-secrets.js: that scanner runs `git grep --untracked`, which
# does not descend into ignored paths, so the exclusion is now structural
# rather than a hardcoded exception the next key can hide behind.
config/
