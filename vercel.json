{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" == \"production\" ] && [[ \"$VERCEL_GIT_COMMIT_MESSAGE\" != *\"[skip ci]\"* ]]; then exit 1; else exit 0; fi",
  "github": {
    "enabled": true,
    "silent": true
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/watchdog",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/queue-refill",
      "schedule": "*/30 * * * *"
    }
  ]
}
