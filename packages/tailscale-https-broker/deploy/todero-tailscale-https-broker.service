[Unit]
Description=Todero Tailscale HTTPS broker
After=tailscaled.service
Requires=tailscaled.service

[Service]
Type=simple
User=todero-tsbroker
Group=todero-tsbroker-sock
EnvironmentFile=/etc/todero/tailscale-https-broker.env
ExecStart=/usr/bin/node /opt/todero/packages/tailscale-https-broker/dist/main.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=todero-tailscale-broker
RuntimeDirectoryMode=0750
StateDirectory=todero-tailscale-broker
StateDirectoryMode=0700
LogsDirectory=todero-tailscale-broker
LogsDirectoryMode=0700
ReadWritePaths=/run/todero-tailscale-broker /var/lib/todero-tailscale-broker /var/log/todero-tailscale-broker

[Install]
WantedBy=multi-user.target
